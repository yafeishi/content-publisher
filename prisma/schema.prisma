generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Content {
  id          String    @id @default(cuid())
  title       String
  body        String
  status      String    @default("draft") // draft, published, scheduled
  platforms   String    @default("[]") // JSON array
  publishedAt DateTime?
  scheduledAt DateTime? // 定时发布时间
  coverImage  String?
  images      String    @default("[]") // JSON array of image paths
  tags        String    @default("[]") // JSON array
  projectId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  path        String
  description String?
  scenario    String?
  needs       String?
  solution    String?
  highlights  String?  // JSON array
  outcomes    String?
  audience    String?
  stage       String?
  techStack   String   @default("[]") // JSON array
  tags        String   @default("[]") // JSON array
  type        String   @default("local") // local, github
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id          String   @id @default(cuid())
  filename    String
  path        String
  type        String   @default("image") // image, video
  projectId   String?
  tags        String   @default("[]") // JSON array
  description String?  // 用户备注，用于搜索
  size        Int?
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model PublishRecord {
  id          String   @id @default(cuid())
  contentId   String
  platform    String   // xiaohongshu, wechat
  status      String   @default("success") // success, failed
  externalId  String?  // platform post ID
  errorMsg    String?
  publishedAt DateTime @default(now())
}

model Log {
  id        String   @id @default(cuid())
  action    String
  result    String
  projectId String?
  contentId String?
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String   // JSON payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
