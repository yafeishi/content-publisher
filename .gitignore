# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
/.run/
/artifacts/
/cookies.json
/cookies.*.json
/.headers on
/.claude/settings.local.json

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.gitignore

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
dev.db
*.db
*.db-journal
*.sqlite
*.sqlite3

# uploads
/public/uploads/*

/src/generated/prisma
.git-history-backup-*/
