# Required: local SQLite database used by Prisma.
DATABASE_URL="file:./dev.db"

# Optional AI provider settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
CODEX_BIN=codex
BUN_BIN=bun

# Optional publishing integrations. Enable only the services you use.
MCP_URL=http://localhost:18060/mcp
MOWEN_API_KEY=
FREEIMAGE_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SKILL_DIR=

# Optional danghb.cn / personal homepage publishing.
# Notes are static pages in the homepage git repo, not a danghb.cn write API.
# Live repo: https://github.com/yafeishi/yafeishi.github.io
# Local folder is sometimes named hobson-homepage or danghb-homepage.
# HOMEPAGE_REPO_PATH overrides the path saved in app settings.
HOMEPAGE_REPO_PATH=
# Token with contents:write on that repo. Never commit the value.
# If empty, commit-push uses the machine's existing git credentials.
HOMEPAGE_GITHUB_TOKEN=
HOMEPAGE_GIT_NAME=
HOMEPAGE_GIT_EMAIL=

# Optional xiaohongshu-mcp overrides.
XHS_MCP_BIN=
XHS_MCP_PORT=18060
XHS_PROFILE_DIR=
