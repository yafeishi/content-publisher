# Required: local SQLite database used by Prisma.
DATABASE_URL="file:./dev.db"

# Optional AI provider settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
CODEX_BIN=codex
BUN_BIN=bun

# Optional publishing integrations. Enable only the services you use.
MCP_URL=http://localhost:18060/mcp
MOWEN_API_KEY=
FREEIMAGE_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SKILL_DIR=

# Optional xiaohongshu-mcp overrides.
XHS_MCP_BIN=
XHS_MCP_PORT=18060
XHS_PROFILE_DIR=
